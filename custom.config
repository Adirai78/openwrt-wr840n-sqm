# ===== CORE SYSTEM =====
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tplink_tl-wr840n-v6=y

# ===== DRIVER & KERNEL =====
CONFIG_PACKAGE_kmod-mt76x8=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y
CONFIG_PACKAGE_kmod-nf-nathelper=y  # Penting untuk NAT

# ===== LUCI ESSENTIALS =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-app-firewall=y

# ===== SQM FULL PACKAGE =====
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_ip-full=y

# ===== SIZE OPTIMIZATION =====
CONFIG_IPV6=n
CONFIG_PACKAGE_ipv6helper=n
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_pppoe=n
CONFIG_PACKAGE_kmod-ppp=n
CONFIG_PACKAGE_kmod-pppoe=n
CONFIG_PACKAGE_kmod-ipv6=n
CONFIG_PACKAGE_luci-proto-ppp=n
CONFIG_PACKAGE_luci-ssl=n
CONFIG_PACKAGE_opkg=n
CONFIG_BUSYBOX_CUSTOM=n

# ===== STRICT SIZE CONTROL =====
CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_luci-app-statistics=n
CONFIG_PACKAGE_iperf3=n
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mno-branch-likely"
CONFIG_TARGET_ROOTFS_PARTSIZE=16
CONFIG_TARGET_IMAGES_PAD=n

# ===== BUILD OPTIONS =====
CONFIG_BUILD_LOG=y  # Untuk debugging
