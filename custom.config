# ---- Target Device (WAJIB) ----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tplink_tl-wr840n-v6=y

# ---- Driver & Sistem Dasar (Kritis) ----
CONFIG_PACKAGE_kmod-mt76x8=y          # Driver WiFi MT7628
CONFIG_PACKAGE_wpad-basic-wolfssl=y    # WPA minimal
CONFIG_PACKAGE_kmod-ipt-ipopt=y       # Dependensi SQM

# ---- LuCI Web Interface ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-mod-status=y

# ---- SQM QoS (Prioritas) ----
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_ip-full=y

# ---- Optimasi Ukuran (WAJIB untuk 4MB) ----
CONFIG_IPV6=n
CONFIG_PACKAGE_ipv6helper=n
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_pppoe=n
CONFIG_PACKAGE_kmod-ppp=n
CONFIG_PACKAGE_kmod-pppoe=n
CONFIG_PACKAGE_kmod-ipv6=n
CONFIG_PACKAGE_luci-proto-ppp=n
CONFIG_PACKAGE_luci-ssl=n
CONFIG_PACKAGE_opkg=n
CONFIG_BUSYBOX_CUSTOM=n

# ---- Tambahan Ringan (Opsional) ----
# CONFIG_PACKAGE_htop=n               # Nonaktifkan jika firmware terlalu besar
# CONFIG_PACKAGE_luci-app-firewall=n  # Sudah termasuk di LuCI core
